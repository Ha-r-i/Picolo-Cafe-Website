# Browser: only public values. Never use VITE_ for a server secret.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-or-anon-key
VITE_API_URL=/api
# Server: copy from `supabase status`, or staging project settings.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-or-anon-key
SUPABASE_SECRET_KEY=replace-with-local-secret-or-service-role-key
# Runtime must be the restricted cafe_api role. Provision it before starting.
DATABASE_URL=postgresql://cafe_api:replace-password@127.0.0.1:54322/postgres
# Used ONLY by migration/seed/bootstrap scripts, never the running API.
ADMIN_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
DATABASE_SSL=false
DATABASE_POOL_MAX=5
PORT=3001
HOST=127.0.0.1
WEB_ORIGIN=http://localhost:3000
GUEST_TOKEN_SECRET=replace-with-at-least-32-random-characters
RATE_LIMIT_SECRET=replace-with-another-32-random-characters
# Set to known reverse proxy IP/CIDR only when deployed. Empty means no proxy trust.
TRUST_PROXY=
LOG_LEVEL=info
RESEND_API_KEY=
EMAIL_FROM=
WORKER_POLL_MS=5000
# Tests refuse to clear a DB unless its database name contains 'test'.
TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/piccolo_test
TEST_SUPABASE_URL=
TEST_SUPABASE_PUBLISHABLE_KEY=
TEST_SUPABASE_SECRET_KEY=
# Operator-only, one-time commands. Do not configure these on API/worker hosts.
# CAFE_API_PASSWORD=at-least-24-random-characters-for-db-role-provisioning
# GOOGLE_ACCESS_TOKEN=short-lived-read-only-token-for-firestore-export
